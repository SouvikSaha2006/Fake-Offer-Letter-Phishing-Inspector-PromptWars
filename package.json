{
  "name": "phishguard-inspector",
  "version": "1.0.0",
  "description": "PhishGuard Inspector - Fake Offer Letter & Phishing Inspector",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"nodemon server/index.js\" \"npm run dev --prefix client\"",
    "dev:server": "nodemon server/index.js",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "test": "node test/testDeterministic.js && node test/testScanPipeline.js",
    "test:scan": "node test/testScanPipeline.js"
  },
  "keywords": [
    "phishing-detector",
    "security",
    "gemini",
    "offer-letter-inspector"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
